# Mnemonic for the deployer account. Funded via the Voyage faucet:
# https://voyage.moi.technology/faucet/
# NEVER commit a real mnemonic. Keep this file as the template; copy to .env locally.
MNEMONIC=""

# MOI network. Known: "devnet" | "babylon"
# `devnet` is the default because the SDK's hardcoded "babylon" host has been
# unreachable from many networks during the 0.6.x → 0.7.x transition. See
# src/networks.ts for details.
MOI_NETWORK="devnet"

# Optional: explicit JSON-RPC URL. Takes precedence over MOI_NETWORK.
# MOI_RPC_URL=""

# Set after running `bun run deploy` — the LOGIC_ID printed by the deploy
# script. Used by `bun run invoke` to address the deployed Flipper.
LOGIC_ID=""
