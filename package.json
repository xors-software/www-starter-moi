{
	"name": "moi-starter",
	"description": "Full-stack starter for MOI Protocol dApps — Next.js + Elysia + Cocolang LOGIC contracts.",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["web", "server", "contracts"],
	"scripts": {
		"dev": "bun run --parallel --filter 'web' --filter 'server' dev",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"build": "bun run --filter 'web' --filter 'server' build",
		"build:web": "bun run --filter web build",
		"build:server": "bun run --filter server build",
		"start": "bun run --filter 'web' --filter 'server' start",
		"test": "bun run --filter 'web' --filter 'server' test",
		"lint": "bun run --filter '*' lint",
		"lint:fix": "bun run --filter '*' lint:fix",
		"format": "bun run --filter '*' format",
		"format:fix": "bun run --filter '*' format:fix",
		"type-check": "bun run --filter '*' type-check",
		"contracts:compile": "bun run --filter contracts compile",
		"contracts:deploy": "bun run --filter contracts deploy",
		"contracts:invoke": "bun run --filter contracts invoke",
		"clean": "rm -rf node_modules web/node_modules server/node_modules contracts/node_modules"
	}
}
