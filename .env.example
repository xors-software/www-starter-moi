# =============================================================================
# Web (Next.js)
# =============================================================================

NEXT_PUBLIC_ENVIRONMENT=development

# MOI network. Known networks: "devnet" | "babylon"
# Default is "devnet" — the only public MOI JSON-RPC endpoint that has been
# reliably reachable through the 0.6.x → 0.7.x SDK transition. See
# web/app/lib/moi/networks.ts and the README for the full story.
NEXT_PUBLIC_MOI_NETWORK=devnet

# Optional: explicit RPC URL — overrides the network's default RPC if set.
# Use this for self-hosted nodes or a future mainnet endpoint.
# NEXT_PUBLIC_MOI_RPC_URL=https://dev.voyage-rpc.moi.technology/devnet/

# LOGIC ID printed by `bun run contracts:deploy`. Required to wire the demo
# FlipperPanel to a live LOGIC. Leave empty before first deploy — the UI will
# render a setup hint instead of the demo.
NEXT_PUBLIC_LOGIC_ID=

# Optional analytics — leave blank or remove if unused.
NEXT_PUBLIC_SEGMENT_WRITE_KEY=

# =============================================================================
# Contracts (deploy/invoke)
# =============================================================================
# These belong in `contracts/.env` (which contracts/scripts/{deploy,invoke}.ts
# read via Bun's automatic dotenv loading). Listed here only for documentation
# — do NOT put a real MNEMONIC in this file.
#
# MNEMONIC=
# MOI_NETWORK=devnet
# MOI_RPC_URL=
# LOGIC_ID=
